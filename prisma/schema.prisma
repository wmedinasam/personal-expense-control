generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  GTQ
  USD
}

// Configuración global (una sola fila, id = "default").
model Setting {
  id              String   @id @default("default")
  defaultCurrency Currency @default(GTQ)
  usdToGtq        Decimal  @default(7.5) @db.Decimal(10, 4)
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#64748b")
  icon      String?   // Nombre de un icono predefinido (ver CATEGORY_ICON_NAMES).
  iconData  String?   // Data URL de un icono subido por el usuario (máx. 100 KB).
  expenses  Expense[]
  budgets   Budget[]  @relation("BudgetCategories")
  createdAt DateTime  @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  currency    Currency @default(GTQ)
  date        DateTime @db.Date
  description String?
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([categoryId, date])
}

model Budget {
  id         String     @id @default(cuid())
  name       String
  amount     Decimal    @db.Decimal(12, 2)
  currency   Currency   @default(GTQ)
  startDate  DateTime   @db.Date
  endDate    DateTime   @db.Date
  categories Category[] @relation("BudgetCategories")
  createdAt  DateTime   @default(now())

  @@index([startDate, endDate])
}
